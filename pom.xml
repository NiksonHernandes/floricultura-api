<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.floricultura</groupId>
	<artifactId>api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>floricultura-api</name>
	<description>API de gestao interna da Floricultura (Spring Boot)</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- Versoes gerenciadas pelo BOM spring-boot-dependencies:4.1.1 (AD-SQ-13) — sem pin manual. -->
	<dependencies>
		<!-- Web MVC (REST). No Boot 4 o starter chama-se spring-boot-starter-webmvc. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Data JPA (mapeamento entra nos milestones de CRUD; ddl-auto=validate) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Validation (Bean Validation / @Valid) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Security (scaffold em M0; SecurityFilterChain permissivo em T-M0-2, JWT em M1) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- JWT (HS256) via Nimbus (SPEC-M1 §3.3): NimbusJwtEncoder/Decoder + ImmutableSecret.
		     Gerenciada pelo BOM spring-boot-dependencies:4.1.1 (Spring Security 7) — SEM pin manual
		     (AD-SQ-13). Traz nimbus-jose-jwt transitivo, tambem BOM-managed. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>

		<!-- Actuator (health, info) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Migracoes versionadas (AD-SQ-3). Desde Flyway 10 o suporte a PostgreSQL e um modulo
		     separado (AD-SQ-13). No Boot 4 a auto-configuracao do Flyway saiu para o modulo
		     spring-boot-flyway (antes vinha em spring-boot-autoconfigure); sem ele o Flyway NAO
		     roda na subida. Todas gerenciadas pelo BOM 4.1.1 (Flyway 12.4.0). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Driver PostgreSQL (runtime) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Testes (JUnit 5 + Spring Boot Test). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Suporte de teste MockMvc / Web MVC (Boot 4: modulo granular; traz AutoConfigureMockMvc). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Suporte de teste do Spring Security (gerenciado pelo BOM 4.1.1 — sem versao). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Integracao Flyway/DDL contra PostgreSQL de descarte (Testcontainers). Versoes do BOM
		     4.1.1 (Testcontainers 2.0.5); no TC 2.x os modulos usam prefixo testcontainers-*. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Segredo JWT test-only (NAO e credencial real; >= 32 bytes so para o HS256) injetado
			     APENAS no JVM de teste (SPEC-M1 §9/§3.3 · B1(a) do gate T-M1-2). Mantem os smokes do
			     M0 (contextLoads/HealthCheck) verdes quando o SecurityConfig passar a exigir o
			     JwtService, SEM tocar em teste do M0. NAO afeta `spring-boot:run`: o fail-fast por
			     APP_JWT_SECRET ausente segue valendo em dev/prod (config so de teste). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<environmentVariables>
						<APP_JWT_SECRET>test-only-nao-segredo-surefire-0123456789abcdef</APP_JWT_SECRET>
					</environmentVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
