# .env.example — modelo de variaveis de ambiente da floricultura-api (SPEC-M0 §3.3, §9 / AD-SQ-9,13).
# Nao ha auto-load de .env no scaffold (AD-SQ-13): EXPORTE estas variaveis no ambiente/IDE em dev
# (run config, plugin EnvFile ou `export` no shell). Este arquivo e so o modelo/documentacao.
# NUNCA versione o `.env` real nem cole segredos em commits, logs, specs ou relatorios (FC-15).

# --- Conexao PostgreSQL (dev) ---
# Formato JDBC. Ex.: jdbc:postgresql://localhost:5432/floricultura
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Profile ativo (opcional; default=dev, ver application.yml) ---
# SPRING_PROFILES_ACTIVE=dev

# --- CORS (usado em prod; em dev o default e http://localhost:4200) ---
# Multiplas origens separadas por virgula.
# APP_CORS_ALLOWED_ORIGINS=

# M1 — seed do 1o ADMIN (gere o HASH BCrypt localmente; a senha NUNCA e versionada)
APP_SEED_ADMIN_EMAIL=
APP_SEED_ADMIN_SENHA_HASH=
# M1 — JWT (segredo >= 32 bytes; TTL em segundos)
APP_JWT_SECRET=
APP_JWT_TTL=3600
